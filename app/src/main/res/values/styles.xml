<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">?attr/primaryColor</item>
        <item name="colorPrimaryVariant">?attr/primaryDarkColor</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">?attr/accentColor</item>
        <item name="colorSecondaryVariant">?attr/accentColor</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- App background and surface colors -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status/navigation bar -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:navigationBarColor">@color/background</item>

        <!-- Default text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>

        <!-- Material 3 Color Overrides -->
        <item name="colorSecondaryContainer">@color/darkGray</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="colorSurfaceVariant">@color/darkGray</item>
        <item name="colorOnSurfaceVariant">@color/white</item>
    </style>

    <!-- Splash screen theme (no action bar, logo centered by layout) -->
    <style name="SplashTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Use solid splash color so the splash layout draws on top -->
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="PreferenceThemeOverlay" parent="AppTheme">
        <item name="colorAccent">?attr/accentColor</item>
        <item name="colorControlActivated">?attr/accentColor</item>
    </style>

</resources>
